// emailOO: visual preview of composing in a separate window (issue #3).
// Nothing is connected yet: fields and toolbar are for layout review only.
import { ScrollView, VerticalBox } from "std-widgets.slint";
import { LineEdit, TextEdit, ToolbarIconButton } from "components/controls.slint";
import { Button } from "components/button.slint";
import { WindowEmailTile } from "message-window.slint";

component FieldRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> value;
    in property <color> label-color;
    spacing: 12px;
    height: 36px;
    Text { width: 64px; text: root.label; color: root.label-color; font-size: 13px; vertical-alignment: center; horizontal-alignment: right; }
    LineEdit { horizontal-stretch: 1; text <=> root.value; input-label: root.label; }
}

export component ComposeWindow inherits Window {
    in property <string> from-address;
    in-out property <string> to;
    in-out property <string> cc;
    in-out property <string> bcc;
    in-out property <string> subject;
    in-out property <string> body;
    in property <string> quote-header;
    in property <[WindowEmailTile]> tiles: [];
    in property <float> content-ratio: 0;
    in property <length> body-width: 760px;
    in property <color> page-color: #ffffff;
    in property <color> text-color: #1d1d1b;
    in property <color> muted-color: #72736f;
    in property <color> line-color: #e4e4e0;
    in property <color> hover-color: #00000014;
    in-out property <string> notice: "";
    callback open-in-main-composer();

    private property <length> editor-height: 220px;
    private property <length> quote-height: quote-text.preferred-height + 12px;

    title: (root.subject != "" ? root.subject : @tr("New message")) + " – " + @tr("New message");
    preferred-width: root.body-width + 48px;
    preferred-height: 920px;
    min-width: 520px;
    min-height: 480px;
    background: root.page-color;

    VerticalBox {
        padding: 16px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 12px;
            height: 36px;
            Button {
                width: self.content-width;
                text: @tr("Send");
                primary: true;
                clicked => { root.notice = @tr("Preview only: this window does not send yet."); }
            }
            Text { horizontal-stretch: 1; text: root.from-address; color: root.text-color; font-size: 13px; vertical-alignment: center; overflow: elide; }
            Button { width: self.content-width; text: @tr("Open in the composer"); clicked => { root.open-in-main-composer(); } }
        }
        if root.notice != "" : Text { text: root.notice; color: #d04a43; font-size: 12px; }

        FieldRow { label: @tr("To:"); value <=> root.to; label-color: root.muted-color; }
        FieldRow { label: @tr("Cc:"); value <=> root.cc; label-color: root.muted-color; }
        FieldRow { label: @tr("Bcc:"); value <=> root.bcc; label-color: root.muted-color; }
        FieldRow { label: @tr("Subject:"); value <=> root.subject; label-color: root.muted-color; }

        Rectangle { height: 1px; background: root.line-color; }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/paperclip.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-text: @tr("Attach files"); }
            Rectangle { width: 6px; }
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/bold.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-text: @tr("Bold"); }
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/italic.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-text: @tr("Italic"); }
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/typography.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-text: @tr("Underline"); }
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/strikethrough.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-text: @tr("Strikethrough"); }
            Rectangle { width: 6px; }
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/list-unordered.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-text: @tr("Bulleted list"); }
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/list-ordered.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-text: @tr("Numbered list"); }
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/quote.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-text: @tr("Quote"); }
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/link.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-text: @tr("Add or edit link"); }
            ToolbarIconButton { icon: @image-url("icons/emailoo/sparkles.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-text: @tr("AI"); }
        }
        Rectangle { height: 1px; background: root.line-color; }

        ScrollView {
            vertical-stretch: 1;
            content-width: root.body-width;
            content-height: root.editor-height + root.quote-height + root.content-ratio * root.body-width + 24px;

            TextEdit {
                x: 0px;
                y: 0px;
                width: root.body-width;
                height: root.editor-height;
                text <=> root.body;
                placeholder-text: @tr("Write your message…");
            }
            quote-text := Text {
                x: 0px;
                y: root.editor-height + 8px;
                width: root.body-width;
                text: root.quote-header;
                color: root.text-color;
                font-size: 13px;
                wrap: word-wrap;
            }
            for tile in root.tiles : Image {
                x: 0px;
                y: root.editor-height + root.quote-height + tile.y * root.body-width;
                width: root.body-width;
                height: tile.height * root.body-width;
                source: tile.image;
                image-fit: fill;
            }
        }
    }
}
