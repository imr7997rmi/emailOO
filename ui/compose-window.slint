// emailOO: visual preview of composing in a separate window (issue #3).
// Nothing is connected yet: fields and toolbar are for layout review only.
import { ComboBox, Palette, ScrollView, VerticalBox } from "std-widgets.slint";
import { LineEdit, SelectionCheckBox, TextEdit, ToolbarIconButton } from "components/controls.slint";
import { Button } from "components/button.slint";
import { Avatar } from "components/avatar.slint";
import { ComposerRecipients } from "components/composer-fields.slint";
import { AccountRow, ComposeAttachment, ComposeContact } from "models.slint";
import { AppTheme, LayoutMetrics } from "design-system.slint";
import { WindowEmailTile } from "message-window.slint";

component FieldRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> value;
    in property <color> label-color;
    spacing: 12px;
    height: 36px;
    Text { width: 64px; text: root.label; color: root.label-color; font-size: 13px; vertical-alignment: center; horizontal-alignment: right; }
    LineEdit { horizontal-stretch: 1; text <=> root.value; input-label: root.label; }
}

export component ComposeWindow inherits Window {
    in-out property <string> to;
    in-out property <string> cc;
    in-out property <string> bcc;
    in-out property <string> subject;
    in-out property <string> body;
    in property <[AccountRow]> accounts: [];
    in-out property <int> account-index: 0;
    in property <[string]> signatures: [];
    in-out property <int> signature-index: 0;
    in property <[string]> sender-names: [];
    in-out property <int> sender-index: 0;
    in property <length> body-width: 760px;
    in-out property <string> theme-mode: "system";
    // Bound to the shared theme so an open compose window follows a theme
    // change, including the native HTML editor through `theme-changed`.
    in property <color> page-color: AppTheme.surface;
    in property <color> text-color: AppTheme.heading;
    in property <color> muted-color: AppTheme.secondary;
    in property <color> line-color: AppTheme.border-subtle;
    in property <color> hover-color: AppTheme.muted-control-bg;
    in-out property <string> notice: "";
    in-out property <bool> notice-error: true;
    // Nextcloud drop dialog (#4): choose between attaching the file or sharing
    // it through a public link with password and expiry.
    in-out property <bool> drop-share-open: false;
    in-out property <string> drop-file-label: "";
    in-out property <string> drop-password: "";
    in-out property <bool> drop-use-password: true;
    in-out property <int> drop-expiry-index: 1;
    in property <[string]> drop-expiry-options: [@tr("1 day"), @tr("30 days"), @tr("No expiry")];
    in property <string> nextcloud_local_path: "";
    // Recipient suggestions from the address book while typing in To/Cc/Bcc.
    in property <[ComposeContact]> contact-suggestions: [];
    in-out property <int> highlighted-contact: 0;
    in property <[ComposeAttachment]> attachments: [];
    in-out property <bool> attachment-preview-open: false;
    in property <image> attachment-preview-image;
    in property <bool> attachment-preview-has-image: false;
    in property <string> attachment-preview-name: "";
    in property <string> attachment-preview-detail: "";
    callback search-contacts(string, int);
    callback select-contact(int, string) -> string;
    callback pick-attachments();
    callback remove-attachment(int);
    callback preview-attachment(int);
    callback close-attachment-preview();
    callback signature-selected(int);
    callback account-selected(int);
    callback sender-selected(int);
    callback insert-nextcloud-link();
    callback generate-drop-password();
    callback drop-attach();
    callback drop-create-link(string, bool, int);
    callback drop-cancel();
    callback open-in-main-composer();
    callback theme-changed();
    // macOS: a native WKWebView (Squire) sits over editor-area; elsewhere the
    // plain TextEdit below is used.
    in property <bool> html-editor: false;
    callback format(string);
    callback send();
    out property <length> editor-x: editor-area.absolute-position.x;
    out property <length> editor-y: editor-area.absolute-position.y;
    out property <length> editor-width: editor-area.width;
    out property <length> editor-height: editor-area.height;
    out property <length> ai-button-x: ai-button.absolute-position.x - editor-area.absolute-position.x;


    title: (root.subject != "" ? root.subject : @tr("New message")) + " – " + @tr("New message");
    preferred-width: root.body-width + 48px;
    preferred-height: 920px;
    min-width: 520px;
    min-height: 480px;
    background: root.page-color;
    changed page-color => { root.theme-changed(); }
    changed text-color => { root.theme-changed(); }
    changed muted-color => { root.theme-changed(); }
    changed line-color => { root.theme-changed(); }
    changed account-index => { root.account-selected(root.account-index); }
    changed theme-mode => {
        Palette.color-scheme = root.theme-mode == "dark" ? ColorScheme.dark
            : root.theme-mode == "light" ? ColorScheme.light : ColorScheme.unknown;
    }

    content := Rectangle {
        width: parent.width;
        height: parent.height;
        VerticalBox {
            padding: 16px;
            spacing: 8px;

        HorizontalLayout {
            spacing: 12px;
            height: 36px;
            Text { width: 64px; text: @tr("Account"); color: root.muted-color; font-size: 13px; vertical-alignment: center; horizontal-alignment: right; }
            Rectangle {
                horizontal-stretch: 1;
                height: 32px;
                border-radius: 6px;
                border-width: 1px;
                border-color: account-hit.has-hover ? AppTheme.input-border : root.line-color;
                background: AppTheme.input-bg;
                account-hit := TouchArea { clicked => { account-popup.show(); } mouse-cursor: pointer; }
                Avatar {
                    x: 6px;
                    y: 4px;
                    size: 22px;
                    source: root.accounts.length > 0 && root.account-index >= 0 && root.account-index < root.accounts.length ? root.accounts[root.account-index].avatar : @image-url("");
                    has-source: root.accounts.length > 0 && root.account-index >= 0 && root.account-index < root.accounts.length ? root.accounts[root.account-index].has_avatar : false;
                    fallback: root.accounts.length > 0 && root.account-index >= 0 && root.account-index < root.accounts.length ? root.accounts[root.account-index].initials : "";
                    background-color: AppTheme.avatar-bg;
                    foreground-color: AppTheme.body;
                }
                Text {
                    x: 36px;
                    width: parent.width - 58px;
                    height: parent.height;
                    text: root.accounts.length > 0 && root.account-index >= 0 && root.account-index < root.accounts.length ? root.accounts[root.account-index].email : "";
                    color: root.text-color;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text { x: parent.width - 20px; width: 14px; height: parent.height; text: "▾"; color: root.muted-color; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                account-popup := PopupWindow {
                    x: 0px;
                    y: parent.height + 2px;
                    width: max(260px, parent.width);
                    height: min(6, root.accounts.length) * 38px + 8px;
                    close-policy: close-on-click-outside;
                    Rectangle {
                        width: parent.width;
                        height: parent.height;
                        background: AppTheme.surface;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: AppTheme.border-subtle;
                        VerticalLayout {
                            padding: 4px;
                            spacing: 0px;
                            for account[index] in root.accounts : Rectangle {
                                height: 38px;
                                background: index == root.account-index ? AppTheme.accent-soft : hit.has-hover ? AppTheme.control-bg : transparent;
                                hit := TouchArea { clicked => { root.account-index = index; account-popup.close(); } mouse-cursor: pointer; }
                                Avatar { x: 8px; y: 7px; size: 24px; source: account.avatar; has-source: account.has_avatar; fallback: account.initials; background-color: AppTheme.avatar-bg; foreground-color: AppTheme.body; }
                                Text { x: 40px; width: parent.width - 48px; height: parent.height; text: account.name != "" && account.name != account.email ? account.name + " · " + account.email : account.email; color: root.text-color; font-size: 13px; vertical-alignment: center; overflow: elide; }
                            }
                        }
                    }
                }
            }
            Text { text: @tr("From"); color: root.muted-color; font-size: 13px; vertical-alignment: center; }
            ComboBox { width: 190px; model: root.sender-names; current-index <=> root.sender-index; changed current-index => { root.sender-selected(root.sender-index); } }
            Text { text: @tr("Signature"); color: root.muted-color; font-size: 13px; vertical-alignment: center; }
            ComboBox { width: 190px; model: root.signatures; current-index <=> root.signature-index; changed current-index => { root.signature-selected(root.signature-index); } }
        }
        HorizontalLayout {
            spacing: 12px;
            height: recipients.panel-height;
            VerticalLayout {
                width: 64px;
                spacing: 8px;
                Text { height: 40px; text: @tr("To") + ":"; color: root.muted-color; font-size: 13px; vertical-alignment: center; horizontal-alignment: right; }
                if recipients.shows-cc : Text { height: 40px; text: @tr("Cc") + ":"; color: root.muted-color; font-size: 13px; vertical-alignment: center; horizontal-alignment: right; }
                if recipients.shows-bcc : Text { height: 40px; text: @tr("Bcc") + ":"; color: root.muted-color; font-size: 13px; vertical-alignment: center; horizontal-alignment: right; }
            }
            recipients := ComposerRecipients {
                horizontal-stretch: 1;
                open: true;
                boxed: true;
                external-labels: true;
                gap: 8px;
                box-background-color: AppTheme.input-bg;
                box-border-color: AppTheme.input-border;
                to <=> root.to;
                cc <=> root.cc;
                bcc <=> root.bcc;
                contacts: root.contact-suggestions;
                highlighted-contact <=> root.highlighted-contact;
                accent-background: root.hover-color;
                accent-color: root.text-color;
                background-color: root.page-color;
                body-color: root.text-color;
                control-hover-color: root.hover-color;
                muted-color: root.muted-color;
                raised-color: root.page-color;
                subtle-border-color: root.line-color;
                title-color: root.text-color;
                search-contacts(value) => { root.search-contacts(value, root.account-index); }
                contact-selected(index) => { root.to = root.select-contact(index, root.to); }
            }
        }
        FieldRow { label: @tr("Subject:"); value <=> root.subject; label-color: root.muted-color; }

        Rectangle { height: 1px; background: root.line-color; }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/paperclip.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-above: true; tooltip-align-left: true; tooltip-text: @tr("Attach files"); clicked => { root.pick-attachments(); } }
            Rectangle { width: 6px; }
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/bold.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-above: true; tooltip-align-left: true; tooltip-text: @tr("Bold"); clicked => { root.format("bold"); } }
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/italic.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-above: true; tooltip-align-left: true; tooltip-text: @tr("Italic"); clicked => { root.format("italic"); } }
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/typography.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-above: true; tooltip-align-left: true; tooltip-text: @tr("Underline"); clicked => { root.format("underline"); } }
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/strikethrough.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-above: true; tooltip-align-left: true; tooltip-text: @tr("Strikethrough"); clicked => { root.format("strike"); } }
            Rectangle { width: 6px; }
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/list-unordered.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-above: true; tooltip-align-left: true; tooltip-text: @tr("Bulleted list"); clicked => { root.format("bullet"); } }
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/list-ordered.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-above: true; tooltip-align-left: true; tooltip-text: @tr("Numbered list"); clicked => { root.format("number"); } }
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/quote.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-above: true; tooltip-align-left: true; tooltip-text: @tr("Quote"); clicked => { root.format("quote"); } }
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/link.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-above: true; tooltip-align-left: true; tooltip-text: @tr("Add or edit link"); clicked => { root.format("link"); } }
            ai-button := ToolbarIconButton { icon: @image-url("icons/emailoo/sparkles.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-above: true; tooltip-align-left: true; tooltip-text: @tr("AI"); clicked => { root.format("ai"); } }
            ToolbarIconButton { icon: @image-url("icons/lucide/filled/cloud.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-above: true; tooltip-align-left: true; tooltip-text: @tr("Insert Nextcloud link"); clicked => { root.insert-nextcloud-link(); } }
        }
        Rectangle { height: 1px; background: root.line-color; }

        if root.attachments.length > 0 : VerticalBox {
            spacing: 0px;
            for attachment[index] in root.attachments : Rectangle {
                height: 30px;
                background: root.page-color;
                Text {
                    x: 8px;
                    width: parent.width - 72px;
                    height: parent.height;
                    text: attachment.name;
                    color: root.text-color;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                preview-hit := TouchArea {
                    x: 8px;
                    width: parent.width - 72px;
                    height: parent.height;
                    clicked => { root.preview-attachment(index); }
                    mouse-cursor: pointer;
                }
                Text {
                    x: parent.width - 62px;
                    width: 40px;
                    height: parent.height;
                    text: attachment.detail;
                    color: root.muted-color;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
                remove-hit := TouchArea {
                    x: parent.width - 24px;
                    width: 24px;
                    height: parent.height;
                    clicked => { root.remove-attachment(index); }
                }
                Text {
                    x: parent.width - 22px;
                    width: 14px;
                    height: parent.height;
                    text: "×";
                    color: remove-hit.has-hover ? root.text-color : root.muted-color;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: root.line-color; }
            }
        }

        // One document: the reply is written above the quoted original, and
        // the quote stays editable to answer point by point.
        editor-area := Rectangle {
            // Drawn below the toolbar so its tooltips stay on top.
            z: -1;
            vertical-stretch: 1;
            if !root.html-editor : TextEdit {
                width: parent.width;
                height: parent.height;
                text <=> root.body;
                placeholder-text: @tr("Write your message…");
            }
        }
        if root.notice != "" : Text { text: root.notice; color: root.notice-error ? #d04a43 : root.muted-color; font-size: 12px; }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            height: LayoutMetrics.sidebar-action-height;
            Button {
                width: max(140px, self.content-width);
                height: LayoutMetrics.sidebar-action-height;
                text: @tr("Send");
                icon: @image-url("icons/lucide/filled/paper-airplane.svg");
                has-icon: true;
                primary: true;
                clicked => { root.send(); }
            }
        }
        }
        if root.drop-share-open : Rectangle {
            background: #00000060;
            z: 20000;
            card := Rectangle {
                width: min(420px, parent.width - 32px);
                height: card-layout.preferred-height;
                background: root.page-color;
                border-radius: 12px;
                border-width: 1px;
                border-color: root.line-color;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                card-layout := VerticalBox {
                    padding: 20px;
                    spacing: 10px;
                    Text { text: @tr("Nextcloud file"); font-size: 16px; font-weight: 600; color: root.text-color; }
                    Text { text: @tr("This file was detected in your Nextcloud storage."); font-size: 13px; color: root.muted-color; wrap: word-wrap; }
                    Text { text: root.drop-file-label; font-size: 13px; color: root.text-color; wrap: word-wrap; font-weight: 600; }
                    HorizontalLayout {
                        spacing: 8px;
                        height: 32px;
                        SelectionCheckBox { checked <=> root.drop-use-password; }
                        Text { text: @tr("Use password"); vertical-alignment: center; font-size: 13px; color: root.text-color; }
                        LineEdit { horizontal-stretch: 1; text <=> root.drop-password; enabled: root.drop-use-password; }
                        Button { text: @tr("Generate"); clicked => { root.generate-drop-password(); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        height: 32px;
                        Text { text: @tr("Expires:"); vertical-alignment: center; font-size: 13px; color: root.text-color; }
                        ComboBox { horizontal-stretch: 1; model: root.drop-expiry-options; current-index <=> root.drop-expiry-index; }
                    }
                    Button { width: parent.width; text: @tr("Attach to message"); clicked => { root.drop-attach(); } }
                    Button { width: parent.width; text: @tr("Create cloud download link"); primary: true; clicked => { root.drop-create-link(root.drop-password, root.drop-use-password, root.drop-expiry-index); } }
                    Button { width: parent.width; text: @tr("Cancel"); clicked => { root.drop-cancel(); } }
                }
            }
        if root.attachment-preview-open : Rectangle {
            background: #00000060;
            z: 21000;
            close-hit := TouchArea { clicked => { root.close-attachment-preview(); } }
            Rectangle {
                width: min(560px, parent.width - 48px);
                height: min(parent.height - 48px, 520px);
                background: root.page-color;
                border-radius: 12px;
                border-width: 1px;
                border-color: root.line-color;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                preview-layout := VerticalBox {
                    padding: 16px;
                    spacing: 10px;
                    Text { text: root.attachment-preview-name; color: root.text-color; font-size: 15px; font-weight: 600; wrap: word-wrap; }
                    Text { text: root.attachment-preview-detail; color: root.muted-color; font-size: 12px; }
                    if root.attachment-preview-has-image : Image {
                        source: root.attachment-preview-image;
                        image-fit: contain;
                        height: 320px;
                    }
                    if !root.attachment-preview-has-image : Text {
                        text: @tr("No preview available for this file.");
                        color: root.muted-color;
                        font-size: 13px;
                    }
                    HorizontalLayout { alignment: end; Button { text: @tr("Close"); clicked => { root.close-attachment-preview(); } } }
                }
            }
        }
        }
    }
}
