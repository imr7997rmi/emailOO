// emailOO: visual preview of composing in a separate window (issue #3).
// Nothing is connected yet: fields and toolbar are for layout review only.
import { ComboBox, ScrollView, VerticalBox } from "std-widgets.slint";
import { LineEdit, TextEdit, ToolbarIconButton } from "components/controls.slint";
import { Button } from "components/button.slint";
import { LayoutMetrics } from "design-system.slint";
import { WindowEmailTile } from "message-window.slint";

component FieldRow inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> value;
    in property <color> label-color;
    spacing: 12px;
    height: 36px;
    Text { width: 64px; text: root.label; color: root.label-color; font-size: 13px; vertical-alignment: center; horizontal-alignment: right; }
    LineEdit { horizontal-stretch: 1; text <=> root.value; input-label: root.label; }
}

export component ComposeWindow inherits Window {
    in-out property <string> to;
    in-out property <string> cc;
    in-out property <string> bcc;
    in-out property <string> subject;
    in-out property <string> body;
    in property <[string]> accounts: [];
    in-out property <int> account-index: 0;
    in property <[string]> signatures: [];
    in-out property <int> signature-index: 0;
    in property <length> body-width: 760px;
    in property <color> page-color: #ffffff;
    in property <color> text-color: #1d1d1b;
    in property <color> muted-color: #72736f;
    in property <color> line-color: #e4e4e0;
    in property <color> hover-color: #00000014;
    in-out property <string> notice: "";
    callback open-in-main-composer();
    // macOS: a native WKWebView (Squire) sits over editor-area; elsewhere the
    // plain TextEdit below is used.
    in property <bool> html-editor: false;
    callback format(string);
    callback send();
    out property <length> editor-x: editor-area.absolute-position.x;
    out property <length> editor-y: editor-area.absolute-position.y;
    out property <length> editor-width: editor-area.width;
    out property <length> editor-height: editor-area.height;
    out property <length> ai-button-x: ai-button.absolute-position.x - editor-area.absolute-position.x;


    title: (root.subject != "" ? root.subject : @tr("New message")) + " – " + @tr("New message");
    preferred-width: root.body-width + 48px;
    preferred-height: 920px;
    min-width: 520px;
    min-height: 480px;
    background: root.page-color;

    VerticalBox {
        padding: 16px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 12px;
            height: 36px;
            Text { width: 64px; text: @tr("Account"); color: root.muted-color; font-size: 13px; vertical-alignment: center; horizontal-alignment: right; }
            ComboBox { horizontal-stretch: 1; model: root.accounts; current-index <=> root.account-index; }
            Text { text: @tr("Signature"); color: root.muted-color; font-size: 13px; vertical-alignment: center; }
            ComboBox { width: 220px; model: root.signatures; current-index <=> root.signature-index; }
        }
        FieldRow { label: @tr("To:"); value <=> root.to; label-color: root.muted-color; }
        FieldRow { label: @tr("Cc:"); value <=> root.cc; label-color: root.muted-color; }
        FieldRow { label: @tr("Bcc:"); value <=> root.bcc; label-color: root.muted-color; }
        FieldRow { label: @tr("Subject:"); value <=> root.subject; label-color: root.muted-color; }

        Rectangle { height: 1px; background: root.line-color; }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/paperclip.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-above: true; tooltip-align-left: true; tooltip-text: @tr("Attach files"); clicked => { root.format("attach"); } }
            Rectangle { width: 6px; }
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/bold.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-above: true; tooltip-align-left: true; tooltip-text: @tr("Bold"); clicked => { root.format("bold"); } }
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/italic.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-above: true; tooltip-align-left: true; tooltip-text: @tr("Italic"); clicked => { root.format("italic"); } }
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/typography.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-above: true; tooltip-align-left: true; tooltip-text: @tr("Underline"); clicked => { root.format("underline"); } }
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/strikethrough.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-above: true; tooltip-align-left: true; tooltip-text: @tr("Strikethrough"); clicked => { root.format("strike"); } }
            Rectangle { width: 6px; }
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/list-unordered.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-above: true; tooltip-align-left: true; tooltip-text: @tr("Bulleted list"); clicked => { root.format("bullet"); } }
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/list-ordered.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-above: true; tooltip-align-left: true; tooltip-text: @tr("Numbered list"); clicked => { root.format("number"); } }
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/quote.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-above: true; tooltip-align-left: true; tooltip-text: @tr("Quote"); clicked => { root.format("quote"); } }
            ToolbarIconButton { icon: @image-url("icons/lucide/outline/link.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-above: true; tooltip-align-left: true; tooltip-text: @tr("Add or edit link"); clicked => { root.format("link"); } }
            ai-button := ToolbarIconButton { icon: @image-url("icons/emailoo/sparkles.svg"); icon-color: root.muted-color; hover-background: root.hover-color; tooltip-above: true; tooltip-align-left: true; tooltip-text: @tr("AI"); clicked => { root.format("ai"); } }
        }
        Rectangle { height: 1px; background: root.line-color; }

        // One document: the reply is written above the quoted original, and
        // the quote stays editable to answer point by point.
        editor-area := Rectangle {
            // Drawn below the toolbar so its tooltips stay on top.
            z: -1;
            vertical-stretch: 1;
            if !root.html-editor : TextEdit {
                width: parent.width;
                height: parent.height;
                text <=> root.body;
                placeholder-text: @tr("Write your message…");
            }
        }
        if root.notice != "" : Text { text: root.notice; color: #d04a43; font-size: 12px; }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            height: LayoutMetrics.sidebar-action-height;
            Button {
                width: max(140px, self.content-width);
                height: LayoutMetrics.sidebar-action-height;
                text: @tr("Send");
                icon: @image-url("icons/lucide/filled/paper-airplane.svg");
                has-icon: true;
                primary: true;
                clicked => { root.send(); }
            }
        }
    }
}
